{
  "name": "@var/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/features/toolbox/lib/*.test.ts src/features/toolbox/*.test.ts src/features/toolbox/*/*.test.ts",
    "lint": "eslint src e2e playwright.config.ts next.config.ts public/sw.js",
    "preview": "node ../../scripts/serve-static.mjs out",
    "predev": "node ../../scripts/copy-pdf-assets.mjs",
    "prebuild": "node ../../scripts/copy-pdf-assets.mjs",
    "postbuild": "node ../../scripts/build-offline.mjs out",
    "format": "prettier --write src e2e *.config.* tsconfig.json components.json",
    "format:check": "prettier --check src e2e *.config.* tsconfig.json components.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "0.3.0",
