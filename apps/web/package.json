    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "docx": "^9.13.0",
    "docx-preview": "^0.4.1",
    "entities": "^8.1.0",
    "exifr": "7.1.3",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "libheif-js": "1.23.5",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.1",
    "next": "16.4.3",
    "opencc-js": "1.4.2",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
